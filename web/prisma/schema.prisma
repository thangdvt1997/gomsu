generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  ADMIN
  EDITOR
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  role         AdminRole @default(ADMIN)
  createdAt    DateTime  @default(now())
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  label     String
  sortOrder Int       @default(0)
  products  Product[]
}

model Glaze {
  id     String         @id @default(cuid())
  key    String         @unique
  label  String
  hex    String
  colors ProductColor[]
}

model Product {
  id              String   @id @default(cuid())
  slug            String   @unique
  code            String   @unique
  name            String
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id])
  tag             String?
  description     String   @db.Text
  featured        Boolean  @default(false)
  isDraft         Boolean  @default(false)
  metaTitle       String?
  metaDescription String?
  ogImage         String?
  // Optional English translations -- when empty, the /en site falls back
  // to the Vietnamese fields above rather than showing blank content.
  nameEn            String?
  tagEn             String?
  descriptionEn     String?  @db.Text
  metaTitleEn       String?
  metaDescriptionEn String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sizes      ProductSize[]
  colors     ProductColor[]
  images     ProductImage[]
  orderItems OrderItem[]
  leads      Lead[]
  reviews    Review[]

  @@index([categoryId])
}

model ProductSize {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String?
  heightCm  Decimal? @db.Decimal(5, 1)
  mouthCm   Decimal? @db.Decimal(5, 1)
  priceVnd  Int? // NULL = "Lien he" (no fixed price) — load-bearing for cart/checkout logic
  stockQty  Int? // NULL = không theo dõi tồn kho (luôn còn hàng); số cụ thể = tồn kho thực
  sortOrder Int      @default(0)

  @@index([productId])
}

model ProductColor {
  productId String
  glazeId   String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  glaze     Glaze   @relation(fields: [glazeId], references: [id])
  sortOrder Int     @default(0)

  @@id([productId, glazeId])
  @@index([glazeId])
}

model ProductImage {
  id                    String   @id @default(cuid())
  productId             String
  product               Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url                    String
  thumbUrl              String?
  alt                    String?
  sortOrder              Int     @default(0)
  isBorrowed             Boolean @default(false)
  borrowedFromProductId  String?

  @@index([productId])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// Real customer reviews only -- starts empty, never seeded with fabricated
// content. Customers submit after purchase; admin moderates before a review
// is APPROVED and counted in the product's public AggregateRating.
model Review {
  id           String       @id @default(cuid())
  productId    String
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerName String
  rating       Int
  title        String?
  comment      String       @db.Text
  status       ReviewStatus @default(PENDING)
  createdAt    DateTime     @default(now())

  @@index([productId])
}

model Post {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  excerpt         String?
  contentHtml     String    @db.Text
  coverImage      String?
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?
  ogImage         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  // Optional English translations -- same fallback-to-Vietnamese pattern as Product.
  titleEn           String?
  excerptEn         String?
  contentHtmlEn     String?  @db.Text
  metaTitleEn       String?
  metaDescriptionEn String?
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  VIETQR
  VNPAY
}

enum CouponType {
  PERCENT
  FIXED
}

model Coupon {
  id          String     @id @default(cuid())
  code        String     @unique
  type        CouponType
  value       Int // PERCENT: 1-100, FIXED: số tiền VNĐ
  minOrderVnd Int?
  maxUses     Int?
  usedCount   Int        @default(0)
  isActive    Boolean    @default(true)
  expiresAt   DateTime?
  createdAt   DateTime   @default(now())

  orders Order[]
}

model Order {
  id               String        @id @default(cuid())
  orderNumber      String        @unique
  status           OrderStatus   @default(PENDING)
  paymentMethod    PaymentMethod @default(VIETQR)
  customerName     String
  customerPhone    String
  customerEmail    String?
  shippingAddress  String
  note             String?
  internalNote     String?       @db.Text // admin-only, never shown to the customer
  subtotalVnd      Int
  discountVnd      Int           @default(0)
  totalVnd         Int
  couponId         String?
  coupon           Coupon?       @relation(fields: [couponId], references: [id])
  paymentProofUrl  String? // screenshot khách tải lên khi chuyển khoản VietQR
  expiresAt        DateTime? // PENDING quá hạn này sẽ tự bị huỷ (xem lib/actions/admin-orders.ts)
  // UTM & ad click-id captured from the landing URL at checkout time, so
  // revenue can be attributed back to a marketing channel/campaign.
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  utmTerm          String?
  utmContent       String?
  gclid            String?
  fbclid           String?
  tag              String? // nhãn khách hàng tự do, vd "Khách sỉ", "VIP", "Khách quen"
  // VNPay-specific reconciliation fields -- unused while paymentMethod is
  // VIETQR (manual bank-transfer confirmation instead), kept for when a
  // real VNPay merchant account exists and paymentMethod=VNPAY is used again.
  vnpTxnRef        String?       @unique
  vnpTransactionNo String?
  vnpBankCode      String?
  vnpResponseCode  String?
  vnpPayDate       String?
  paidAt           DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  items OrderItem[]

  @@index([couponId])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product @relation(fields: [productId], references: [id])
  productName  String
  sizeLabel    String?
  glazeLabel   String?
  unitPriceVnd Int
  quantity     Int
  lineTotalVnd Int

  @@index([orderId])
}

enum LeadKind {
  QUOTE_REQUEST
  CONTACT_MESSAGE
}

enum LeadStatus {
  NEW
  CONTACTED
  CLOSED
}

model Lead {
  id        String     @id @default(cuid())
  kind      LeadKind
  name      String
  phone     String
  email     String?
  message   String?    @db.Text
  productId String?
  product   Product?   @relation(fields: [productId], references: [id])
  status    LeadStatus @default(NEW)
  tag       String? // nhãn tự do, vd "Khách sỉ", "VIP", "Khách quen"
  createdAt DateTime   @default(now())

  @@index([productId])
}

model SiteSetting {
  key   String @id
  value String @db.Text
}
