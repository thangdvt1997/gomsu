generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  ADMIN
  EDITOR
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  role         AdminRole @default(ADMIN)
  createdAt    DateTime  @default(now())
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  label     String
  sortOrder Int       @default(0)
  products  Product[]
}

model Glaze {
  id     String         @id @default(cuid())
  key    String         @unique
  label  String
  hex    String
  colors ProductColor[]
}

model Product {
  id              String   @id @default(cuid())
  slug            String   @unique
  code            String   @unique
  name            String
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id])
  tag             String?
  description     String   @db.Text
  featured        Boolean  @default(false)
  isDraft         Boolean  @default(false)
  metaTitle       String?
  metaDescription String?
  ogImage         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sizes      ProductSize[]
  colors     ProductColor[]
  images     ProductImage[]
  orderItems OrderItem[]
  leads      Lead[]

  @@index([categoryId])
}

model ProductSize {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String?
  heightCm  Decimal? @db.Decimal(5, 1)
  mouthCm   Decimal? @db.Decimal(5, 1)
  priceVnd  Int? // NULL = "Lien he" (no fixed price) — load-bearing for cart/checkout logic
  sortOrder Int      @default(0)

  @@index([productId])
}

model ProductColor {
  productId String
  glazeId   String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  glaze     Glaze   @relation(fields: [glazeId], references: [id])
  sortOrder Int     @default(0)

  @@id([productId, glazeId])
  @@index([glazeId])
}

model ProductImage {
  id                    String   @id @default(cuid())
  productId             String
  product               Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url                    String
  thumbUrl              String?
  alt                    String?
  sortOrder              Int     @default(0)
  isBorrowed             Boolean @default(false)
  borrowedFromProductId  String?

  @@index([productId])
}

model Post {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  excerpt         String?
  contentHtml     String    @db.Text
  coverImage      String?
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?
  ogImage         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

model Order {
  id               String      @id @default(cuid())
  orderNumber      String      @unique
  status           OrderStatus @default(PENDING)
  customerName     String
  customerPhone    String
  customerEmail    String?
  shippingAddress  String
  note             String?
  subtotalVnd      Int
  totalVnd         Int
  vnpTxnRef        String?     @unique
  vnpTransactionNo String?
  vnpBankCode      String?
  vnpResponseCode  String?
  vnpPayDate       String?
  paidAt           DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  items OrderItem[]
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product @relation(fields: [productId], references: [id])
  productName  String
  sizeLabel    String?
  glazeLabel   String?
  unitPriceVnd Int
  quantity     Int
  lineTotalVnd Int

  @@index([orderId])
}

enum LeadKind {
  QUOTE_REQUEST
  CONTACT_MESSAGE
}

enum LeadStatus {
  NEW
  CONTACTED
  CLOSED
}

model Lead {
  id        String     @id @default(cuid())
  kind      LeadKind
  name      String
  phone     String
  email     String?
  message   String?    @db.Text
  productId String?
  product   Product?   @relation(fields: [productId], references: [id])
  status    LeadStatus @default(NEW)
  createdAt DateTime   @default(now())

  @@index([productId])
}

model SiteSetting {
  key   String @id
  value String @db.Text
}
