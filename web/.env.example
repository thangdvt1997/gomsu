# Postgres (docker-compose service name "postgres")
DATABASE_URL=postgresql://gomsu:changeme@postgres:5432/gomsu

# Public site URL — used for canonical links, sitemap, OG tags, VNPay return URL.
# Fix for the bug found in the old static site: canonical/sitemap/robots were
# hardcoded to gomsutrungmung.vn instead of the real live domain.
NEXT_PUBLIC_SITE_URL=https://gomceramic.com

# Auth.js
AUTH_SECRET=changeme-generate-with-openssl-rand-base64-32
NEXTAUTH_URL=https://gomceramic.com

# First admin user, read once by prisma/seed.ts (idempotent — only inserted if missing)
ADMIN_EMAIL=admin@gomceramic.com
ADMIN_PASSWORD=changeme

# VNPay (sandbox values — see https://sandbox.vnpayment.vn merchant portal)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://gomceramic.com/thanh-toan/ket-qua
VNPAY_VERSION=2.1.0
VNPAY_CURRENCY=VND
VNPAY_LOCALE=vn

# SEO / analytics — leave blank to disable, or set via /admin/settings at runtime
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_ANALYTICS_ENABLED=false
