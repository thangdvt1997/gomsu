# Postgres (docker-compose service name "postgres")
DATABASE_URL=postgresql://gomsu:changeme@postgres:5432/gomsu

# Public site URL — used for canonical links, sitemap, OG tags, VNPay return URL.
# Fix for the bug found in the old static site: canonical/sitemap/robots were
# hardcoded to gomsutrungmung.vn instead of the real live domain.
NEXT_PUBLIC_SITE_URL=https://gomceramic.com

# Auth.js
# Deliberately no AUTH_URL/NEXTAUTH_URL here: auth.ts sets trustHost: true, so
# Auth.js derives the base URL from each request's actual Host header instead
# of a fixed value. A fixed URL breaks any environment reached through a
# different hostname than the one it names -- e.g. the e2e test container
# hitting the app via the internal Docker hostname "app:3000" while a fixed
# NEXTAUTH_URL pointed at the external IP: signIn()'s redirect then targets
# the wrong host, the session cookie (host-scoped) doesn't follow, and the
# user bounces right back to the login page. Set this only if you have a
# specific reason to pin the host (e.g. multiple domains proxying to the same
# app where only one should be treated as canonical for auth).
AUTH_SECRET=changeme-generate-with-openssl-rand-base64-32

# First admin user, read once by prisma/seed.ts (idempotent — only inserted if missing)
ADMIN_EMAIL=admin@gomceramic.com
ADMIN_PASSWORD=changeme

# VNPay (sandbox values — see https://sandbox.vnpayment.vn merchant portal)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://gomceramic.com/thanh-toan/ket-qua
VNPAY_VERSION=2.1.0
VNPAY_CURRENCY=VND
VNPAY_LOCALE=vn

# SEO / analytics — leave blank to disable, or set via /admin/settings at runtime
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_ANALYTICS_ENABLED=false
